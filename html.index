<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Hola Eli ❤️</title>

<style>
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

body{
    background:#000;
    display:flex;
    justify-content:center;
    align-items:center;
    flex-direction:column;
    height:100vh;
    overflow:hidden;
    font-family:Arial, Helvetica, sans-serif;
}

button{
    padding:18px 45px;
    font-size:22px;
    border:none;
    border-radius:50px;
    cursor:pointer;
    background:#ff004c;
    color:white;
    transition:.35s;
    box-shadow:0 0 25px #ff0055;
}

button:hover{
    transform:scale(1.08);
    box-shadow:0 0 40px #ff0055;
}

#heart{
    margin-top:40px;
    display:grid;
    grid-template-columns:repeat(8,28px);
    grid-template-rows:repeat(7,28px);
    gap:3px;
    opacity:0;
    transform:scale(.4);
}

.pixel{
    width:28px;
    height:28px;
    background:transparent;
}

.on{
    background:#ff003c;
    box-shadow:
    0 0 10px #ff003c,
    0 0 20px #ff003c;
}

.show{
    animation:pop .7s forwards;
}

@keyframes pop{

0%{
transform:scale(.4);
opacity:0;
}

100%{
transform:scale(1);
opacity:1;
}

}

.beat{
animation:beat 1s infinite;
}

@keyframes beat{

0%{transform:scale(1);}
25%{transform:scale(1.08);}
50%{transform:scale(1);}
75%{transform:scale(1.08);}
100%{transform:scale(1);}

}
</style>

</head>

<body>

<button id="btn">
Hola Eli ❤️
</button>

<div id="heart"></div>

<script>

const dibujo=[
[0,1],[0,2],[0,5],[0,6],
[1,0],[1,1],[1,2],[1,3],[1,4],[1,5],[1,6],[1,7],
[2,0],[2,1],[2,2],[2,3],[2,4],[2,5],[2,6],[2,7],
[3,1],[3,2],[3,3],[3,4],[3,5],[3,6],
[4,2],[4,3],[4,4],[4,5],
[5,3],[5,4],
[6,3]
];

const heart=document.getElementById("heart");

for(let i=0;i<56;i++){
const div=document.createElement("div");
div.className="pixel";
heart.appendChild(div);
}

const pixels=document.querySelectorAll(".pixel");

document.getElementById("btn").onclick=function(){

this.style.display="none";

heart.classList.add("show");

let i=0;

const intervalo=setInterval(()=>{

if(i>=dibujo.length){

clearInterval(intervalo);

heart.classList.add("beat");

return;

}

const fila=dibujo[i][0];
const columna=dibujo[i][1];

const indice=fila*8+columna;

pixels[indice].classList.add("on");

i++;

},80);

}

</script>

</body>
</html>
